# Copy this file to .env and fill only the values you need.
# .env is ignored by Git and Docker; never commit real credentials.

# Hugging Face read token. Required for gated model repositories after you
# accept their terms on huggingface.co.
HF_TOKEN=

# Optional bearer token required by LatentSlate clients connecting to Engine.
# Set this for LAN or remote/Vast.ai deployments.
LATENTSLATE_ENGINE_TOKEN=

# Optional storage overrides.
# HF_HOME=C:/path/to/huggingface-cache
# LATENTSLATE_ENGINE_HOME=C:/path/to/latentslate-engine-data
